{
  "name": "RICH X CAM LIVE",
  "productName": "RICH X CAM LIVE",
  "version": "1.0.0",
  "description": "RICH X CAM LIVE — Real-Time Video and Audio Voice Conversion Desktop Application with bundled RICHX CAM Virtual Camera and Microphone drivers.",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "dist:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.richxcam.live",
    "productName": "RICH X CAM LIVE",
    "win": {
      "target": ["nsis"],
      "icon": "public/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["en_US"],
      "include": "installer/install-drivers.nsh",
      "deleteAppDataOnUninstall": true
    },
    "extraResources": [
      {
        "from": "drivers/virtual-camera/",
        "to": "drivers/virtual-camera/",
        "filter": ["**/*"]
      },
      {
        "from": "drivers/virtual-audio/",
        "to": "drivers/virtual-audio/",
        "filter": ["**/*"]
      }
    ]
  }
}
